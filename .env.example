# Copy to .env.local for local builds. On Render: service > Environment, then redeploy.

# The live domain, no trailing slash. Used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=

# Where the enquiry form posts (a Formspree or Web3Forms endpoint that accepts JSON).
# Leave empty and the form opens WhatsApp with the enquiry filled in instead.
NEXT_PUBLIC_FORM_ENDPOINT=
